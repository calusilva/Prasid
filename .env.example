# ─────────────────────────────────────────────────────────────
#  Configuração do envio de propostas do configurador de calhas
#  Copiar para `.env.local` e preencher.
# ─────────────────────────────────────────────────────────────

# Chave da API Resend (https://resend.com/api-keys).
# Se ficar vazia, os pedidos são gravados em ./proposals/*.json
# em vez de enviados por email (útil em desenvolvimento).
RESEND_API_KEY=

# Destinatário na empresa que recebe os pedidos de proposta.
PROPOSAL_TO_EMAIL=geral@prasidiberica.pt

# Remetente. Tem de ser um domínio/endereço verificado no Resend.
# Em testes pode usar-se "Prasid Ibérica <onboarding@resend.dev>".
PROPOSAL_FROM_EMAIL="Prasid Ibérica <onboarding@resend.dev>"
